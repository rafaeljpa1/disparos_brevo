# Chave de API do Brevo (obrigatória)
# Gere em: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Remetente de e-mail (precisa estar verificado no Brevo)
REMETENTE_NOME=Capela
REMETENTE_EMAIL=tiago@capela.press

# Remetente de SMS: máx. 11 caracteres alfanuméricos (ou 15 numéricos)
SMS_REMETENTE=Capela

# Número do WhatsApp Business conectado ao Brevo (formato internacional)
WHATSAPP_REMETENTE=

# --- Disparos regionais (PNLD 2027) ---

# Landing pages dos botões dos templates (regional cai no nacional se vazio)
LINK_LP_NACIONAL=https://casadeletras.com.br/pnld-2027/
LINK_LP_REGIONAL=

# Dados obrigatórios do rodapé do e-mail (lei anti-spam / boas práticas).
# O envio real é bloqueado enquanto estiverem vazios.
EDITORA_ENDERECO=
EDITORA_CNPJ=
EDITORA_DOMINIO=

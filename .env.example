# Chave de API do Brevo (obrigatória)
# Gere em: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Remetente de e-mail (precisa estar verificado no Brevo)
REMETENTE_NOME=Capela
REMETENTE_EMAIL=tiago@capela.press

# Remetente de SMS: máx. 11 caracteres alfanuméricos (ou 15 numéricos)
SMS_REMETENTE=Capela

# Número do WhatsApp Business conectado ao Brevo (formato internacional)
WHATSAPP_REMETENTE=

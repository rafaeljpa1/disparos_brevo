# Chave de API do Brevo (obrigatória)
# Gere em: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Remetente de e-mail (precisa estar verificado no Brevo)
REMETENTE_NOME=Capela
REMETENTE_EMAIL=tiago@capela.press

# Remetente de SMS: máx. 11 caracteres alfanuméricos (ou 15 numéricos)
SMS_REMETENTE=Capela

# Número do WhatsApp Business conectado ao Brevo (formato internacional)
WHATSAPP_REMETENTE=

# --- Disparos regionais (PNLD 2027) ---

# Landing pages dos botões dos templates.
# "{regiao}" é trocado pelo slug da região (norte, nordeste, centro-oeste,
# sudeste, sul). O link regional cai no nacional se ficar vazio.
LINK_LP_NACIONAL=https://casadeletras.com.br/pnld-2027/
LINK_LP_REGIONAL=https://casadeletras.com.br/pnld-2027-{regiao}/

# Dados do rodapé do e-mail, espelhando o rodapé do site (obrigatórios
# por lei anti-spam — o envio real é bloqueado enquanto estiverem vazios).
EDITORA_RAZAO_SOCIAL=Casa de Letras e Gráfica Ltda
EDITORA_CNPJ=48.764.955/0001-41
EDITORA_ENDERECO=Rua Fradique Coutinho, 1139 – Pinheiros · CEP 05416-011 · São Paulo – SP
EDITORA_EMAIL_CONTATO=comercial@casadeletras.com.br

# Destino do link "Política de privacidade" do rodapé
LINK_POLITICA_PRIVACIDADE=https://casadeletras.com.br/politica-de-privacidade/

# O logo "Casa de Letras" do topo do e-mail vira link para o site
LINK_SITE=https://casadeletras.com.br/

# URL da imagem do logo (o mesmo do rodapé do site) — entra no rodapé do
# e-mail, acima de "Editora Casa de Letras", clicável para o site.
# ATENÇÃO: este logo é branco; sobre o fundo bege do e-mail ele some.
LOGO_RODAPE_URL=https://casadeletras.com.br/wp-content/uploads/2026/06/lp-logo-footer.png?v=9a53ac4f
